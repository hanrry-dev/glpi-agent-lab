    {
      "name": "5. Escrita (GRAVA NO BANCO)",
      "item": [
        {
          "name": "Criar chamado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api.php/v2/Assistance/Ticket",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api.php",
                "v2",
                "Assistance",
                "Ticket"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teste do meu agente\",\n  \"content\": \"<p>Chamado criado pelo Postman.</p>\",\n  \"priority\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
