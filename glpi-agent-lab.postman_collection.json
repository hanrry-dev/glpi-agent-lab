  "info": {
    "name": "GLPI Agent Lab",
    "description": "Testes da API v2 do GLPI 11 (lab). Preencha clientId e clientSecret nas variáveis da coleção (lab/oauth-client.md) e rode 'Obter token' primeiro.\n\nAtenção: a pasta 'Escrita' grava de verdade no banco. Para restaurar: docker compose down -v && docker compose up -d --build (dentro de lab/).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "clientSecret",
      "value": ""
    },
    {
      "key": "username",
      "value": "glpi"
    },
    {
      "key": "password",
      "value": "glpi"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "ticket_id",
      "value": "1"
    },
    {
      "key": "article_id",
      "value": "1"
    },
    {
      "key": "category_id",
      "value": "1"
