            },
            "description": "Esperado 206 com Content-Range 0-9/300. Use 'date' (abertura real), nunca date_creation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 2xx\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "pm.test(\"206 (parcial) ou 200 (cobre tudo)\", function () { pm.expect([200, 206]).to.include(pm.response.code); });",
                  "pm.test(\"Header Content-Range presente\", function () { pm.expect(pm.response.headers.has(\"Content-Range\")).to.be.true; });",
                  "pm.test(\"Corpo é uma lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "pm.test(\"Campos esperados\", function () { const t = pm.response.json()[0]; [\"id\",\"name\",\"status\",\"category\",\"date\"].forEach(k => pm.expect(t).to.have.property(k)); });",
                  "const cr = pm.response.headers.get(\"Content-Range\"); if (cr) console.log(\"Content-Range:\", cr);"
                ]
