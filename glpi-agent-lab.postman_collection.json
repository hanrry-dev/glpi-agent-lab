  "item": [
    {
      "name": "0. Autenticação",
      "item": [
        {
          "name": "Obter token (rode primeiro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api.php/token",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api.php",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"password\",\n  \"client_id\": \"{{clientId}}\",\n  \"client_secret\": \"{{clientSecret}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"scope\": \"api\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 2xx\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", j.access_token);",
                  "if (j.refresh_token) pm.collectionVariables.set(\"refresh_token\", j.refresh_token);",
                  "pm.test(\"access_token recebido\", function () { pm.expect(j.access_token).to.be.a(\"string\"); });",
                  "pm.test(\"expira em 3600s\", function () { pm.expect(j.expires_in).to.eql(3600); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar token (refresh_token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api.php/token",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api.php",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"refresh_token\",\n  \"refresh_token\": \"{{refresh_token}}\",\n  \"client_id\": \"{{clientId}}\",\n  \"client_secret\": \"{{clientSecret}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Pedir token novo invalida o anterior; o script já atualiza access_token e refresh_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 2xx\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", j.access_token);",
                  "if (j.refresh_token) pm.collectionVariables.set(\"refresh_token\", j.refresh_token);",
                  "pm.test(\"access_token recebido\", function () { pm.expect(j.access_token).to.be.a(\"string\"); });",
                  "pm.test(\"expira em 3600s\", function () { pm.expect(j.expires_in).to.eql(3600); });"
                ]
              }
            }
          ]
        }
      ]
    },
